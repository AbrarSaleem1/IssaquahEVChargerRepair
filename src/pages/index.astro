---
import Layout from '../layouts/Layout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CTABand from '../components/CTABand.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const services = [
  { slug: 'level-2-ev-charger-repair', title: 'Level 2 EV Charger Repair', desc: 'Hardware repair and electrical diagnostics for 240V residential charging units experiencing thermal throttling and relay cutouts.' },
  { slug: 'tesla-wall-connector-repair', title: 'Tesla Wall Connector Repair', desc: 'Diagnosing red blinking fault codes, power throttling, handle overheating, and internal board errors on Gen 2 & Gen 3 units.' },
  { slug: 'ev-charger-troubleshooting', title: 'EV Charger Diagnostics & Troubleshooting', desc: 'Root-cause testing for red indicator lights, handshake errors, communication drops, and ground fault warnings.' },
  { slug: 'nema-14-50-outlet-repair', title: 'NEMA 14-50 Burnt Outlet Repair', desc: 'Emergency replacement of melted, charred, or loose 240V builder-grade receptacles with heavy-duty industrial Hubbell/Bryant 9450A hardware.' },
  { slug: 'ev-charger-circuit-repair', title: 'EV Charger Circuit & Breaker Repair', desc: 'Repairing tripped double-pole breakers, busbar arcing, loose wire lugs, and nuisance GFCI conflicts on dedicated EV branch lines.' },
  { slug: 'electrical-panel-repair-ev', title: 'Electrical Panel Repair for EV Charging', desc: 'Resolving main service breaker trips, buzzing panels, phase voltage imbalances, and installing automated EV load management systems.' },
  { slug: 'emergency-ev-charger-repair', title: '24/7 Emergency EV Charger Repair', desc: 'Rapid same-day dispatch across Issaquah for burning plastic smells, stuck charging handles, tripped main power, and blackout faults.' },
  { slug: 'commercial-ev-charger-repair', title: 'Commercial EV Charger Repair', desc: 'Maintenance and urgent repair for workplace, retail, HOA condo, and fleet charging stations including RFID, contactors, and cables.' },
  { slug: 'ev-charger-maintenance', title: 'EV Charger Preventive Maintenance', desc: 'Scheduled electrical tune-ups including infrared thermal scans, terminal torque re-verification, and ground loop resistance testing.' },
  { slug: 'ev-charger-replacement', title: 'Defective Charger Replacement', desc: 'Safe decommissioning and replacement of unrepairable or burned-out charging units on existing code-compliant branch circuits.' },
  { slug: 'ev-charging-cable-handle-repair', title: 'EV Cable, Latch & Handle Repair', desc: 'Replacing damaged cords, cracked J1772 locking latches, broken NACS release buttons, and pitted high-amperage connector pins.' },
  { slug: 'ev-charger-wiring-repair', title: 'EV Charger Dedicated Wiring Repair', desc: 'Fixing undersized Romex conductors, conduit moisture intrusion, damaged aluminum runs, and persistent ground-fault lockouts.' },
  { slug: 'amazon-ev-charger-repair', title: 'Universal & Amazon Brand Charger Repair', desc: 'Independent diagnostic service for customer-purchased smart chargers including Emporia, Grizzl-E, JuiceBox, Wallbox, and Autel.' },
  { slug: 'multi-ev-system-repair', title: 'Dual EV Charger & Load Sharing Repair', desc: 'Re-synchronizing wireless power sharing between dual chargers, fixing smart energy monitors, and eliminating subpanel tripping.' },
];

const neighborhoods = [
  { slug: 'issaquah-highlands', name: 'Issaquah Highlands', zip: '98029', desc: 'Rapid repair for high-density EV households near Grand Ridge Plaza.' },
  { slug: 'talus', name: 'Talus', zip: '98027', desc: 'Hillside homes and executive properties along Shangri-La Way on Squak Mountain.' },
  { slug: 'klahanie', name: 'Klahanie', zip: '98029', desc: 'Diagnostic and repair services for subdivisions and lakefront communities.' },
  { slug: 'providence-point', name: 'Providence Point', zip: '98029', desc: 'Gated 55+ active adult community condo and carport EV charger repairs.' },
  { slug: 'grand-ridge', name: 'Grand Ridge', zip: '98029', desc: 'Custom luxury estates with multi-bay garages and dual-EV system troubleshooting.' },
  { slug: 'olde-town-issaquah', name: 'Olde Town Issaquah (Downtown)', zip: '98027', desc: 'Historic homes with aged electrical panels requiring specialized EV circuit repair.' },
  { slug: 'squak-mountain', name: 'Squak Mountain', zip: '98027', desc: 'Hillside properties experiencing weather-related ground faults and circuit trips.' },
  { slug: 'newport', name: 'Newport', zip: '98029', desc: 'Suburban residences along Lake Sammamish corridors needing fast diagnostic help.' },
  { slug: 'gilman', name: 'Gilman', zip: '98027', desc: 'Central residential and boutique commercial EV charger maintenance and repair.' },
  { slug: 'sycamore', name: 'Sycamore', zip: '98027', desc: 'Established tree-lined neighborhoods near central Issaquah schools and parks.' },
  { slug: 'central-issaquah', name: 'Central Issaquah', zip: '98027 / 98029', desc: 'Mixed-use residential hubs and commercial properties along the I-90 corridor.' },
  { slug: 'greenwood-point', name: 'Greenwood Point', zip: '98029', desc: 'Waterfront and plateau residences adjacent to South Lake Sammamish.' },
  { slug: 'tiger-mountain', name: 'Tiger Mountain', zip: '98027', desc: 'Rural acreage and forested properties with high continuous power EV loads.' },
  { slug: 'mirrormont', name: 'Mirrormont', zip: '98027', desc: 'Spacious wooded acreage lots with detached workshop and garage charging issues.' },
  { slug: 'preston', name: 'Preston', zip: '98050', desc: 'Historic community just east of Issaquah along the Raging River and I-90 corridor.' },
];

const faqs = [
  {
    question: "Why is my EV charger flashing red or displaying a ground fault warning?",
    answer: "A flashing red light or fault signal typically indicates a broken ground connection, voltage drop on the 240V supply line, an internal contactor failure, or high resistance at the terminal block. In Washington's damp climate, moisture intrusion inside exterior-mounted enclosures or loose terminal lugs can also trigger internal GFCI sensors. We perform diagnostic meter testing to identify whether the issue originates in the unit, the breaker, or the branch wiring."
  },
  {
    question: "Can an EV charger be repaired instead of buying a whole new unit?",
    answer: "Yes, in the majority of cases! Most failures stem from loose terminal blocks, burnt 240V receptacles, worn breakers, broken J1772/NACS latches, or tripped internal contactors. Our licensed electricians carry replacement components to resolve the issue on-site, saving you hundreds of dollars compared to whole-station replacement."
  },
  {
    question: "Why does my EV charger trip the breaker after 20 to 45 minutes of charging?",
    answer: "This is a classic symptom of thermal overload. EV chargers draw massive continuous current (32A to 48A). If terminal screws are not torqued to exact factory inch-pounds, or if the breaker has aged internal springs, heat accumulates until the breaker trips on thermal overcurrent. We use infrared thermal imaging to locate and repair the hot spot."
  },
  {
    question: "Why did my NEMA 14-50 outlet melt or smell like burning plastic?",
    answer: "Many builder-grade NEMA 14-50 receptacles were designed for intermittent stove usage, not the intense continuous 32-amp to 40-amp current demanded by electric vehicles for 6 to 10 hours straight. Cheap outlets expand under heavy heat, loosening terminal screws and creating high electrical resistance that melts the plastic housing. We repair the circuit by installing industrial-grade EV-rated receptacles (such as Bryant or Hubbell 9450A)."
  },
  {
    question: "How quickly can your technicians respond to an EV charger emergency in Issaquah?",
    answer: "Because our technicians are based locally in Issaquah (serving 98027 and 98029), we provide rapid same-day and 24/7 emergency dispatch. Most standard diagnostic and repair visits take 45 to 90 minutes, and our trucks carry common replacement breakers, industrial outlets, and heavy-duty wire to resolve faults on the first visit."
  }
];
