---
import Layout from '../layouts/Layout.astro';
import TrustStrip from '../components/TrustStrip.astro';
import CTABand from '../components/CTABand.astro';
import FAQAccordion from '../components/FAQAccordion.astro';

const services = [
  { slug: 'level-2-ev-charger-installation', title: 'Level 2 EV Charger Installation', desc: 'Hardwired 240V, 32A to 48A residential charging installations providing 25 to 44 miles of range per hour of charge.' },
  { slug: 'ev-charger-troubleshooting', title: 'EV Charger Troubleshooting', desc: 'Diagnostic testing for red indicator lights, handshake errors, communication drops, and ground fault warnings.' },
  { slug: 'tesla-wall-connector-installation-repair', title: 'Tesla Wall Connector Installation & Repair', desc: 'Certified installation and thermal sensor repair for Gen 2, Gen 3, and Universal Tesla Wall Connectors.' },
  { slug: 'panel-upgrade-for-ev-charging', title: 'Panel Upgrade for EV Charging', desc: 'Modernize 100A or 150A electrical panels to 200A or 400A heavy-up services to support high-draw EV circuits safely.' },
  { slug: 'ev-ready-home-wiring', title: 'EV-Ready Home Wiring', desc: 'Future-proof conduit runs, dedicated copper branch circuits, and subpanel provisioning for upcoming EV purchases.' },
  { slug: 'nema-14-50-outlet-installation-repair', title: 'NEMA 14-50 Outlet Install & Repair', desc: 'Heavy-duty commercial-grade 50-amp receptacle replacements eliminating dangerous melting risks from budget outlets.' },
  { slug: 'multi-ev-home-charging', title: 'Multi-EV Home Charging', desc: 'Smart dual-charger load-sharing installations allowing two electric cars to charge simultaneously on one feeder.' },
  { slug: 'ev-charger-relocation', title: 'EV Charger Relocation', desc: 'Safely unmount, extend branch wiring, and re-certify charging stations for garage renovations or new parking layouts.' },
  { slug: 'amazon-ev-charger-installation-repair', title: 'Amazon EV Charger Installation & Repair', desc: 'Installation and circuit setup for chargers purchased online, including Grizzl-E, Autel, Emporia, and ChargePoint.' },
  { slug: 'ev-charger-circuit-repair-installation', title: 'EV Charger Circuit Repair & Installation', desc: 'Repair damaged romex, fix undersized feeder cables, and replace tripping two-pole dedicated double breakers.' },
  { slug: 'commercial-ev-charging', title: 'Commercial EV Charging', desc: 'Turnkey workplace, multi-family, retail, and fleet charging infrastructure installations with metering capabilities.' },
  { slug: 'ev-charger-installation', title: 'EV Charger Installation', desc: 'Turnkey home EVSE setups tailored to your specific vehicle model, garage configuration, and electrical capacity.' },
  { slug: 'ev-charger-maintenance', title: 'EV Charger Maintenance', desc: 'Cable wear checks, connector pin inspection, terminal torque re-verification, and firmware health assessments.' },
  { slug: 'ev-charger-replacement', title: 'EV Charger Replacement', desc: 'Swap outdated or unrepairable charging units with high-efficiency smart stations using existing electrical infrastructure.' },
];

const neighborhoods = [
  { slug: 'issaquah-highlands', name: 'Issaquah Highlands', zip: '98029', desc: 'Master-planned townhomes and single-family properties near Grand Ridge Plaza.' },
  { slug: 'talus', name: 'Talus', zip: '98027', desc: 'Hillside homes and executive properties along Shangri-La Way on Squak Mountain.' },
  { slug: 'klahanie', name: 'Klahanie', zip: '98029', desc: 'Established residential subdivisions and lakefront communities near Yellow Lake.' },
  { slug: 'providence-point', name: 'Providence Point', zip: '98029', desc: 'Gated 55+ active adult community requiring tailored condo and carport charging solutions.' },
  { slug: 'grand-ridge', name: 'Grand Ridge', zip: '98029', desc: 'Custom luxury estates with multi-bay garages and multi-EV charging requirements.' },
  { slug: 'olde-town-issaquah', name: 'Olde Town Issaquah (Downtown)', zip: '98027', desc: 'Historic residential properties with classic 100A service panels needing careful updates.' },
  { slug: 'squak-mountain', name: 'Squak Mountain', zip: '98027', desc: 'Wooded residential hillside properties requiring customized conduit pathways.' },
  { slug: 'newport', name: 'Newport', zip: '98029', desc: 'Suburban neighborhoods along Lake Sammamish corridors with modern charging demands.' },
  { slug: 'gilman', name: 'Gilman', zip: '98027', desc: 'Central residential and boutique commercial corridors near historic Gilman Village.' },
  { slug: 'sycamore', name: 'Sycamore', zip: '98027', desc: 'Quiet established tree-lined neighborhoods near central Issaquah schools and parks.' },
  { slug: 'central-issaquah', name: 'Central Issaquah', zip: '98027 / 98029', desc: 'Mixed-use residential hubs and commercial properties along the I-90 corridor.' },
  { slug: 'greenwood-point', name: 'Greenwood Point', zip: '98029', desc: 'Waterfront and plateau residences adjacent to South Lake Sammamish.' },
  { slug: 'tiger-mountain', name: 'Tiger Mountain', zip: '98027', desc: 'Rural acreage and forested properties with high continuous power requirements.' },
  { slug: 'mirrormont', name: 'Mirrormont', zip: '98027', desc: 'Spacious wooded acreage lots south of downtown with detached garages and workshops.' },
  { slug: 'preston', name: 'Preston', zip: '98050', desc: 'Historic community just east of Issaquah along the Raging River and I-90 corridor.' },
];

const faqs = [
  {
    question: "Why is my EV charger flashing red or displaying a ground fault warning?",
    answer: "A flashing red light or fault signal typically indicates a broken ground connection, voltage drop on the 240V supply line, an internal contactor failure, or high resistance at the terminal block. In Washington's damp climate, moisture intrusion inside exterior-mounted enclosures or loose terminal lugs can also trigger internal GFCI sensors. We perform diagnostic meter testing to identify whether the issue originates in the unit, the breaker, or the branch wiring."
  },
  {
    question: "Do I need an electrical permit to install or replace an EV charger in Issaquah?",
    answer: "Yes. In Issaquah and across King County, adding a new 240-volt dedicated circuit, upgrading an electrical service panel, or replacing hardwired EV charging equipment requires an electrical permit under Washington Administrative Code (WAC 296-46B) and the National Electrical Code (NEC Article 625). Our licensed electricians pull all required permits and ensure the completed installation satisfies local City of Issaquah and L&I inspection standards."
  },
  {
    question: "Can my existing electrical panel handle a Level 2 EV charger?",
    answer: "That depends on your panel's total amperage rating (commonly 100A, 150A, or 200A) and your home's current electrical load from appliances like heat pumps, water heaters, and electric ranges. A Level 2 charger drawing 40A to 48A requires a dedicated 50A or 60A two-pole circuit breaker. During an on-site consultation, we perform an official load calculation to determine if your panel has sufficient capacity or if a subpanel or panel upgrade is necessary."
  },
  {
    question: "Why did my NEMA 14-50 outlet melt or smell like burning plastic?",
    answer: "Many builder-grade NEMA 14-50 receptacles were designed for intermittent stove or RV usage, not the intense continuous 32-amp continuous current demanded by electric vehicles for 6 to 10 hours straight. Cheap outlets expand and contract under heavy heat, loosening terminal screws and creating high electrical resistance that melts the plastic housing. We install industrial-grade EV-rated receptacles (such as Bryant or Hubbell) with properly torqued connections to prevent thermal failure."
  },
  {
    question: "How long does a typical EV charger troubleshooting or repair visit take?",
    answer: "Most on-site diagnostic inspections take between 45 and 90 minutes. Our technicians test input voltage, measure load under charge, inspect breaker terminals, verify grounding rod continuity, and test charging cable pins. Minor issues such as loose wire terminals, faulty breakers, or bad receptacles can often be resolved during the same visit."
  }
];
