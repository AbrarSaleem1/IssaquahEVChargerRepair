    slug: 'electrical-panel-repair-ev',
    title: 'Rural Panel Upgrades',
    desc: 'Upgrading older 100A or 150A panels in Tiger Mountain properties to 200A load centers capable of supporting continuous EV charging alongside well pumps and heating systems.'
  },
  {
    slug: 'level-2-ev-charger-repair',
    title: 'Level 2 Repairs for Rural Properties',
    desc: 'Hardwired 240V repairs adapted for properties with detached garages, carports, long driveways, and varied distances from the main electrical panel.'
  },
  {
    slug: 'ev-charger-circuit-repair',
    title: 'Long-Run Circuit Repair',
    desc: 'Dedicated EV circuits designed for the extended conduit distances common on Tiger Mountain acreage properties, with conductors sized to prevent voltage drop.'
  },
  {
    slug: 'ev-charger-troubleshooting',
    title: 'Rural Power Quality Diagnostics',
    desc: 'Troubleshooting charger faults caused by overhead PSE line voltage fluctuations, wildlife-related outages, and grounding issues unique to rural electrical service.'
  }
];

const nearbyAreas = [
  { name: 'Squak Mountain', url: '/locations/squak-mountain/', note: 'Adjacent mountain residential area to the north and west.' },
  { name: 'Mirrormont', url: '/locations/mirrormont/', note: 'Established forested community along Tiger Mountain foothills to the south.' },
  { name: 'Issaquah Highlands', url: '/locations/issaquah-highlands/', note: 'Modern planned community to the northwest along Highlands Drive NE.' }
];

const faqs = [
  {
    question: "Can I install an EV charger on a rural Tiger Mountain property with a 100-amp panel?",
    answer: "A 100-amp panel may support a lower-amperage charger (24A or 32A) if your total home load is modest. However, Tiger Mountain homes with well pumps, electric heating, and shop circuits frequently require a panel upgrade to 200A before adding EV charging. We calculate exact load requirements for every property."
  },
  {
    question: "How do you handle long distances between the panel and garage on Tiger Mountain properties?",
    answer: "Long conduit runs increase voltage drop under high-amperage loads. For distances over 50 feet, we upsize conductors from 6 AWG to 4 AWG or even 2 AWG copper, depending on circuit length and amperage. Underground runs use schedule 40 PVC conduit buried at code-required depths."
  },
  {
    question: "Does Tiger Mountain's overhead power affect EV charging reliability?",
    answer: "Overhead PSE lines are more susceptible to voltage fluctuations, weather-related outages, and wildlife interference than underground service. We install whole-panel surge protective devices (SPDs) to protect your EV charger from power surges, and we test line voltage stability during diagnostic visits."
  },
  {
    question: "Can you repair a charger in a detached barn or shop building on Tiger Mountain?",
    answer: "Yes. Detached structures require a dedicated subpanel with separate grounding electrodes, fed by appropriately sized conductors from the main panel. We route feeders underground or overhead depending on the property layout and distance."
  },
  {
    question: "How far do you travel for Tiger Mountain service calls?",
    answer: "We serve all properties in the Tiger Mountain area, from homes along Tiger Mountain Road SE to properties accessed via Issaquah-Hobart Road SE. Our dispatch center at 612 Jasmine Pl NW is approximately 15 to 25 minutes from most Tiger Mountain addresses."
  }
];
