  { name: 'Sycamore', url: '/locations/sycamore/', note: 'Nearby residential development north of Newport Way SE.' }
];

const faqs = [
  {
    question: "Do Newport homes typically have enough panel capacity for a Level 2 charger?",
    answer: "Most Newport homes built in the 1990s and 2000s have 200-amp panels, which generally support a 48-amp EV circuit. However, homes with electric heat pumps, hot tubs, or multiple high-draw appliances may need a load calculation to confirm available capacity. We perform NEC Article 220 assessments on every project."
  },
  {
    question: "Can you route charger wiring through a finished basement in Newport?",
    answer: "Yes. Many Newport homes have finished lower levels between the panel and garage. We route conductors through existing utility chases, above drop ceilings, or through crawlspace access points to avoid cutting finished walls. When surface conduit is the only option, we use low-profile painted raceways."
  },
  {
    question: "How long does a typical Newport EV Charger Repair take?",
    answer: "Most repairs in Newport homes with the panel in the garage or utility room take 3 to 5 hours. If the panel is on the opposite side of the house from the garage, conduit routing may extend the project to a full day."
  },
  {
    question: "Do you service all EV brands in Newport?",
    answer: "Yes. We install and repair chargers for Tesla, Rivian, BMW, Porsche, Mercedes-Benz, Hyundai, Kia, Chevrolet, Ford, Volkswagen, Audi, and all other electric vehicle manufacturers. Our work focuses on the electrical infrastructure, which is universal regardless of vehicle brand."
  },
  {
    question: "What permits are required for an EV Charger Repair in Newport?",
    answer: "All new 240-volt branch circuits and panel modifications require an electrical permit through the City of Issaquah or WA L&I. Our licensed contractors handle all permit applications and coordinate final inspections on your behalf."
  }
];
