      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2.5rem; align-items: center;">
        <div class="contact-hero-card">
          <h3 style="margin-top: 0; margin-bottom: 1.5rem;">Sycamore Dispatch</h3>
          <div class="contact-detail-row">
            <div class="contact-detail-icon">📞</div>
            <div>
              <div style="font-size: 0.9rem; color: #64748b;">Phone Line</div>
