---
import Layout from '../../layouts/Layout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const allNeighborhoods = [
  {
    slug: 'issaquah-highlands',
    name: 'Issaquah Highlands',
    zip: '98029',
    description: 'High-density master-planned community with modern townhomes, alley garages, and strict IHCA conduit routing standards.'
  },
  {
    slug: 'talus',
    name: 'Talus',
    zip: '98027',
    description: 'Mountain-side multi-level executive homes and hillside townhomes along Shangri-La Way with complex vertical conduit pathways.'
  },
  {
    slug: 'klahanie',
    name: 'Klahanie',
    zip: '98029',
    description: 'Established residential subdivisions around Yellow Lake requiring panel load assessments and heavy-duty NEMA 14-50 upgrades.'
  },
  {
    slug: 'providence-point',
    name: 'Providence Point',
    zip: '98029',
    description: 'Gated 55+ active adult community requiring specialized condominium carport and detached garage charging repairs.'
  },
  {
