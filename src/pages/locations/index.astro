    description: 'Luxury estate homes and acreage properties requiring 400-amp service heavy-ups and dual-vehicle power-sharing setups.'
  },
  {
    slug: 'olde-town-issaquah',
    name: 'Olde Town Issaquah (Downtown)',
    zip: '98027',
    description: 'Historic homes and craftsman bungalows near Front Street requiring 100A service upgrades and detached garage wiring.'
  },
  {
    slug: 'squak-mountain',
    name: 'Squak Mountain',
    zip: '98027',
    description: 'Forested hillside properties with long service drops and specialized exterior-rated conduit repairs.'
  },
  {
    slug: 'newport',
    name: 'Newport',
    zip: '98029',
    description: 'Residential communities near Lake Sammamish with modern multi-vehicle charging requirements.'
  },
  {
    slug: 'gilman',
    name: 'Gilman',
    zip: '98027',
    description: 'Central neighborhoods surrounding Gilman Village featuring mixed commercial and residential electrical systems.'
  },
  {
    slug: 'sycamore',
    name: 'Sycamore',
    zip: '98027',
    description: 'Established suburban streets with attached two-car garages and high demand for dedicated 240V circuits.'
  },
  {
    slug: 'central-issaquah',
    name: 'Central Issaquah',
    zip: '98027 / 98029',
    description: 'Core commercial and residential corridor along I-90 featuring workplace and retail charging infrastructure.'
  },
  {
    slug: 'greenwood-point',
    name: 'Greenwood Point',
    zip: '98029',
    description: 'Scenic waterfront and plateau properties along the southern shore of Lake Sammamish.'
  },
  {
    slug: 'tiger-mountain',
    name: 'Tiger Mountain',
    zip: '98027',
    description: 'Rural acreage and foothill homes requiring dedicated subpanels, generator interlocks, and surge protection.'
  },
  {
    slug: 'mirrormont',
    name: 'Mirrormont',
    zip: '98027',
    description: 'Wooded acreage lots south of downtown with detached workshops, barns, and long branch circuit trenching.'
  },
  {
    slug: 'preston',
    name: 'Preston',
    zip: '98050',
    description: 'Historic Eastside community off I-90 with rural residential properties requiring comprehensive electrical upgrades.'
  }
