  { name: 'Squak Mountain', url: '/locations/squak-mountain/', note: 'Neighboring mountain residential community to the north.' },
  { name: 'Preston', url: '/locations/preston/', note: 'Rural community to the southeast along the Preston-Fall City corridor.' }
];

const faqs = [
  {
    question: "What panel sizes do Mirrormont homes typically have?",
    answer: "Homes built in the 1970s-1980s in Mirrormont typically have 100-amp or 150-amp panels. Homes built in the 1990s-2000s generally have 200-amp panels. We inspect your specific panel and perform NEC Article 220 load calculations to determine if an upgrade is needed for EV charging."
  },
  {
    question: "Does Mirrormont have an HOA that governs charger repairs?",
    answer: "If an HOA is active in Mirrormont, repairs inside attached garages typically do not require approval. Any exterior modifications may need review. Washington State law limits HOA restrictions on EV Charger Repairs, and we provide documentation to facilitate the approval process."
  },
  {
    question: "Is overhead power a concern for EV charging in Mirrormont?",
    answer: "Overhead PSE service is more vulnerable to power surges from lightning, falling branches, and wildlife contact. We install surge protective devices (SPDs) at the panel to protect your charger from damaging voltage spikes."
  },
  {
    question: "Can you repair a charger if my Mirrormont garage is below the main level?",
    answer: "Yes. Many Mirrormont homes on sloped lots have garages on a lower level. We route circuits through interior walls, crawlspaces, or utility chases to reach the garage without cutting through finished living spaces."
  },
  {
    question: "How long is the drive from your office to Mirrormont?",
    answer: "Our dispatch center at 612 Jasmine Pl NW is approximately 10 to 20 minutes from most Mirrormont addresses, depending on the specific location within the community."
  }
];
