    slug: 'level-2-ev-charger-repair',
    title: 'Mirrormont Home charger repairs',
    desc: 'Hardwired 240V Level 2 Repairs for Mirrormont homes with attached garages, properly routed through finished spaces and utility areas.'
  },
  {
    slug: 'electrical-panel-repair-ev',
    title: 'Mirrormont Panel Modernization',
    desc: 'Upgrading 100A and 150A panels in 1970s-1990s Mirrormont homes to 200A load centers with dedicated EV circuit capacity.'
  },
  {
    slug: 'ev-charger-troubleshooting',
    title: 'Foothill Charger Diagnostics',
    desc: 'Diagnosing fault codes, breaker trips, and voltage fluctuation issues in Mirrormont garages with overhead PSE electrical service.'
  },
