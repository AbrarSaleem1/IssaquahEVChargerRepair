    slug: 'commercial-ev-charger-repair',
    title: 'Condo & Multi-Family Charging Infrastructure',
    desc: 'Specialized electrical design for Providence Point condominium clusters, shared carport banks, and subterranean parking structures requiring dedicated sub-metering.'
  },
  {
    slug: 'ev-charger-wiring-repair',
    title: 'Long-Distance Carport Conduit Pathways',
    desc: 'Engineering code-compliant conduit pathways from centralized building electrical rooms across exterior grounds to assigned resident parking spaces.'
  },
  {
    slug: 'ev-charger-troubleshooting',
    title: 'Shared Subpanel & Neutral Diagnostics',
    desc: 'Resolving nuisance breaker trips, shared neutral conductor issues, and voltage instability in older multi-unit distribution centers.'
  },
  {
    slug: 'ev-charger-replacement',
    title: 'RFID & Access-Controlled Charger Modernization',
    desc: 'Upgrading older or malfunctioning charging units with keycard, RFID, or smartphone access to prevent unauthorized charging in common parking areas.'
  }
];

const nearbyAreas = [
  { name: 'Klahanie', url: '/locations/klahanie/', note: 'Directly bordering master-planned community to the east across Issaquah plateau roads.' },
  { name: 'Issaquah Highlands', url: '/locations/issaquah-highlands/', note: 'Just north along the plateau connecting via Highlands Drive NE.' },
  { name: 'Newport', url: '/locations/newport/', note: 'Southwest along the Lake Sammamish corridor towards central Issaquah.' }
];

const providencePointFaqs = [
  {
    question: "Can an EV charger be installed in my Providence Point assigned carport or garage space?",
    answer: "Yes. Under Washington State RCW 64.38.060 (the Washington State EV Charging in Common Interest Communities law), condominium associations and HOAs cannot prohibit homeowners from installing an electric vehicle charging station at their designated parking space, provided the repair satisfies building codes and community architectural standards. We coordinate directly with the Providence Point Umbrella Association to submit compliant electrical plans, conduit pathways, and insurance documentation."
  },
  {
    question: "How is electricity billed when a charger is installed in a shared carport?",
    answer: "In condominium communities like Providence Point, parking spaces are often powered through a common-area house panel rather than an individual homeowner's unit meter. To ensure accurate billing, we install smart, networked Level 2 charging stations with revenue-grade internal meters or private sub-meters. These stations track exact kilowatt-hour consumption and generate automated billing reports for association reimbursement, or route power through a dedicated utility meter."
  },
  {
    question: "Why does my EV charger trip when charging in our multi-unit building?",
    answer: "Multi-family buildings constructed in the 1980s and 1990s often share neutral conductors or have tight electrical headroom on floor subpanels. When an electric car pulls continuous high amperage, harmonics or slight neutral imbalances can cause shared dual-pole breakers to trip. Our technicians inspect the distribution panel, isolate neutral returns, and test line impedance to ensure your charger operates without disrupting adjacent building circuits."
  },
  {
    question: "What is the approval process with the Providence Point architectural committee?",
    answer: "Before commencing work, an architectural alteration application must be filed with the Providence Point Umbrella Association board. The application requires an electrical single-line diagram, conduit routing schematics, proof of contractor electrical licensing and bonding, and manufacturer cut sheets for the proposed EVSE. We prepare the entire technical documentation package on your behalf to expedite board approval."
  },
  {
    question: "Are there low-profile charging options that prevent cords from creating tripping hazards?",
    answer: "Yes. In an active adult community, keeping pathways clear is essential. We install wall-mounted cable retractor reels, overhead articulating cord management booms, or pedestal-mounted stations with integrated holster locks. These solutions keep charging cables off pedestrian walkways, preventing tripping hazards and protecting the cable from vehicle wheel damage."
  }
];
