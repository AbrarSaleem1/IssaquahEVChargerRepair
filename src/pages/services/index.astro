---
import Layout from '../../layouts/Layout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const allServices = [
  {
    slug: 'level-2-ev-charger-repair',
    title: 'Level 2 EV Charger Repair',
    summary: 'Diagnostics and hardware repair for 240V residential charging units experiencing thermal throttling, relay failures, and error cutouts.',
    icon: '⚡'
  },
  {
    slug: 'tesla-wall-connector-repair',
    title: 'Tesla Wall Connector Repair',
    summary: 'Deciphering red blink fault codes, resolving current throttling, handle overheating, and internal board errors for Gen 2 & Gen 3 units.',
    icon: '🔋'
  },
  {
    slug: 'ev-charger-troubleshooting',
    title: 'EV Charger Diagnostics & Troubleshooting',
    summary: 'Comprehensive testing using calibrated multimeters, thermal cameras, and EVSE simulators to isolate the exact cause of charging failure.',
    icon: '🔍'
  },
  {
    slug: 'nema-14-50-outlet-repair',
    title: 'NEMA 14-50 Burnt Outlet Repair',
    summary: 'Emergency replacement of melted, charred, or loose 240V builder-grade receptacles with heavy-duty industrial Hubbell/Bryant 9450A hardware.',
    icon: '🛡️'
  },
  {
    slug: 'ev-charger-circuit-repair',
    title: 'EV Charger Circuit & Breaker Repair',
    summary: 'Repairing tripped double-pole breakers, busbar arcing, loose wire lugs, and nuisance GFCI conflicts on dedicated EV branch lines.',
    icon: '🛠️'
  },
  {
    slug: 'electrical-panel-repair-ev',
    title: 'Electrical Panel Repair for EV Charging',
    summary: 'Resolving main service breaker trips, buzzing panels, phase voltage imbalances, and installing automated EV load management systems.',
    icon: '⚙️'
  },
  {
    slug: 'emergency-ev-charger-repair',
    title: '24/7 Emergency EV Charger Repair',
    summary: 'Rapid same-day dispatch across Issaquah for burning plastic smells, stuck charging handles, tripped main power, and blackout faults.',
    icon: '🚨'
  },
  {
    slug: 'commercial-ev-charger-repair',
    title: 'Commercial EV Charger Repair',
    summary: 'Maintenance and urgent repair for workplace, retail, HOA condo, and fleet charging stations including RFID, contactors, and cables.',
    icon: '🏢'
  },
  {
    slug: 'ev-charger-maintenance',
    title: 'EV Charger Preventive Maintenance',
    summary: 'Scheduled electrical tune-ups including infrared thermal scans, terminal torque re-verification, and ground loop resistance testing.',
    icon: '📋'
  },
  {
    slug: 'ev-charger-replacement',
    title: 'Defective Charger Replacement',
    summary: 'Safe decommissioning and replacement of unrepairable or burned-out charging units on existing code-compliant branch circuits.',
    icon: '🔄'
  },
  {
    slug: 'ev-charging-cable-handle-repair',
    title: 'EV Cable, Latch & Handle Repair',
    summary: 'Replacing damaged cords, cracked J1772 locking latches, broken NACS release buttons, and pitted high-amperage connector pins.',
    icon: '🔌'
  },
  {
    slug: 'ev-charger-wiring-repair',
    title: 'EV Charger Dedicated Wiring Repair',
    summary: 'Fixing undersized Romex conductors, conduit moisture intrusion, damaged aluminum runs, and persistent ground-fault lockouts.',
    icon: '⚡'
  },
  {
    slug: 'amazon-ev-charger-repair',
    title: 'Universal & Amazon Brand Charger Repair',
    summary: 'Independent diagnostic service for customer-purchased smart chargers including Emporia, Grizzl-E, JuiceBox, Wallbox, and Autel.',
    icon: '📦'
  },
  {
    slug: 'multi-ev-system-repair',
    title: 'Dual EV Charger & Load Sharing Repair',
    summary: 'Re-synchronizing wireless power sharing between dual chargers, fixing smart energy monitors, and eliminating subpanel tripping.',
    icon: '🚗'
  }
];

const faqs = [
  {
    question: "How do your technicians diagnose an EV charger that won't turn on?",
    answer: "We employ systematic electrical troubleshooting: testing line-to-line 240V supply voltage at the breaker and unit terminals, checking control transformer voltages, measuring ground loop impedance, and reading onboard microcontroller fault registers."
  },
  {
    question: "Are your EV repair services code-compliant with Washington State regulations?",
    answer: "Yes. All diagnostic and repair work is performed by licensed electrical specialists in strict accordance with Washington Administrative Code (WAC 296-46B), NEC Article 625 (Electric Vehicle Power Transfer System), and local Issaquah safety standards."
  },
  {
    question: "What should I do if my charger trips the breaker immediately upon plugging in?",
    answer: "Immediate breaker tripping usually indicates a dead short, a direct ground fault in the charging cable, or a shorted contactor inside the EVSE unit. Turn off the breaker and do not attempt repeated resets, as high fault currents can cause thermal busbar damage. Contact our technicians for on-site diagnostic testing."
  },
  {
    question: "Can an EV charger be repaired on-site or does it have to be shipped away?",
    answer: "The vast majority of faults (over 85%)—such as loose terminals, overheated breakers, burnt receptacles, damaged cables, ground loops, or misconfigured dip switches—are repaired right on-site in your Issaquah garage during our initial service visit."
  },
  {
    question: "What brands and models of EV chargers do your repair technicians service?",
    answer: "We diagnose and repair all major brands including Tesla (Universal Wall Connector, Gen 3, Gen 2), ChargePoint Home Flex, Wallbox Pulsar Plus, Emporia, Autel MaxiCharger, Grizzl-E, Siemens VersiCharge, Bosch, and ClipperCreek/Enphase units."
  }
];
---

<Layout
  title="EV Charger Repair Services in Issaquah, WA | Serving 98027 & 98029"
  description="Explore all 14 specialized EV charger repair services from Issaquah EV Charger Repair. Troubleshooting, Level 2 fixes, Tesla repair, burnt outlets. Call (425) 380-0019."
  canonicalPath="/services/"
>
  <Breadcrumbs items={[
    { name: 'Home', url: '/' },
    { name: 'Services', url: '/services/' }
  ]} />

  <!-- Hero Banner -->
  <section class="hero-section">
    <div class="container">
      <div style="max-width: 800px;">
        <span class="section-tag" style="background: rgba(132, 204, 22, 0.2); color: #84cc16;">Specialized EV Repair Services</span>
        <h1>Comprehensive EV Charger Repair in Issaquah (98027 & 98029)</h1>
        <p class="hero-lead">
          Our licensed electricians provide dedicated diagnostic and repair services for residential and commercial electric vehicle supply equipment across Issaquah. From red fault light troubleshooting to melted 240V outlet repairs, explore our 14 repair specialties below.
        </p>
        <div class="hero-cta-wrap">
          <a href="tel:+14253800019" class="btn btn-lime">
            <span>📞</span>
            <span>Call (425) 380-0019</span>
          </a>
          <a href="/locations/" class="btn btn-outline-white">
            View Service Areas
          </a>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  <!-- All Services Grid -->
  <section class="section">
    <div class="container">
      <div class="section-title-wrap">
        <span class="section-tag">Repair Directory</span>
        <h2>All 14 Dedicated EV Charger Repair Specialties</h2>
        <p class="section-subtitle">
          Select any service below to explore detailed technical diagnostics, root cause failure explanations, and field repair procedures.
        </p>
      </div>

      <figure class="seo-feature-figure" style="margin-block: 2.5rem; text-align: center;">
        <img 
          src="/images/ev-charger-troubleshooting-diagnostic-multimeter.jpg" 
          alt="Certified electrician using precision diagnostic instruments to repair an EV charger in Issaquah WA"
          width="1000"
          height="500"
          loading="lazy"
          decoding="async"
          style="width: 100%; max-height: 460px; object-fit: cover; border-radius: 12px; border: 1px solid #cbd5e1; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);"
        />
        <figcaption style="margin-top: 0.65rem; font-size: 0.88rem; color: #64748b; font-style: italic;">
          Professional EV charger troubleshooting, component testing, and circuit repair across Issaquah zip codes 98027 & 98029.
        </figcaption>
      </figure>

      <div class="cards-grid">
        {allServices.map(srv => (
          <div class="feature-card">
            <div class="feature-icon">{srv.icon}</div>
            <h3 class="card-title">{srv.title}</h3>
            <p class="card-text">{srv.summary}</p>
            <a href={`/services/${srv.slug}/`} class="card-link">
              View Repair Guide →
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process Section -->
  <section class="section" style="background: #ffffff; border-top: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0;">
    <div class="container">
      <div class="section-title-wrap">
        <span class="section-tag">Diagnostic Protocol</span>
        <h2>Our 4-Step Electrical Repair Approach</h2>
        <p class="section-subtitle">
          Every charging station repair follows rigorous safety testing and electrical diagnostic standards.
        </p>
      </div>

      <div class="process-grid">
        <div class="process-card">
          <div class="process-step-num">1</div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Intake & Error Code Reading</h3>
          <p style="font-size: 0.95rem; color: #475569; margin-bottom: 0;">We decode hardware blink counts, download microprocessor event logs, and analyze vehicle warning messages.</p>
        </div>

        <div class="process-card">
          <div class="process-step-num">2</div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Thermal & Voltage Scrutiny</h3>
          <p style="font-size: 0.95rem; color: #475569; margin-bottom: 0;">We measure split-phase voltage stability, test ground loop impedance, and scan panels with FLIR infrared cameras.</p>
        </div>

        <div class="process-card">
          <div class="process-step-num">3</div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Component & Circuit Repair</h3>
          <p style="font-size: 0.95rem; color: #475569; margin-bottom: 0;">We repair terminal connections, replace burnt receptacles, swap defective contactors, and re-torque all lugs to spec.</p>
        </div>

        <div class="process-card">
          <div class="process-step-num">4</div>
          <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">Simulated Load Certification</h3>
          <p style="font-size: 0.95rem; color: #475569; margin-bottom: 0;">We run sustained full-amperage simulated test cycles to certify zero thermal buildup before clearing the system for daily use.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hardware & Panel Showcase -->
  <section style="padding-top: 1.5rem; padding-bottom: 3.5rem;">
    <div class="container">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
        <figure class="seo-feature-figure" style="margin: 0; text-align: center;">
          <img 
            src="/images/tesla-wall-connector-repair-installation.jpg" 
            alt="Field testing internal wiring inside a Tesla Wall Connector in Issaquah WA"
            width="600"
            height="380"
            loading="lazy"
            decoding="async"
            style="width: 100%; height: 320px; object-fit: cover; border-radius: 12px; border: 1px solid #cbd5e1; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);"
          />
          <figcaption style="margin-top: 0.65rem; font-size: 0.88rem; color: #64748b; font-style: italic;">
            Tesla Wall Connector repair: resolving red blink error codes, ribbon cable faults, and 48A thermal throttling.
          </figcaption>
        </figure>
        <figure class="seo-feature-figure" style="margin: 0; text-align: center;">
          <img 
            src="/images/panel-upgrade-200-amp-circuit-breakers.jpg" 
            alt="Electrical panel breaker repair and busbar testing for EV charging in Issaquah"
            width="600"
            height="380"
            loading="lazy"
            decoding="async"
            style="width: 100%; height: 320px; object-fit: cover; border-radius: 12px; border: 1px solid #cbd5e1; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.08);"
          />
          <figcaption style="margin-top: 0.65rem; font-size: 0.88rem; color: #64748b; font-style: italic;">
            Electrical panel & circuit repairs: eliminating breaker nuisance tripping and busbar arcing under high EV draw.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" style="background: #f8fafc;">
    <div class="container" style="max-width: 900px;">
      <h2 style="text-align: center; margin-bottom: 2rem;">EV Charger Repair FAQs</h2>
      <FAQAccordion items={faqs} />
    </div>
  </section>

  <!-- CTA Band -->
  <CTABand
    title="Need Rapid EV Charger Troubleshooting or Hardware Repair?"
    description="Speak directly with an Issaquah electrical specialist to schedule an on-site diagnostic visit across 98027 & 98029."
    primaryBtnText="Call (425) 380-0019"
    primaryBtnUrl="tel:+14253800019"
    secondaryBtnText="Explore All 15 Locations"
    secondaryBtnUrl="/locations/"
  />
</Layout>
