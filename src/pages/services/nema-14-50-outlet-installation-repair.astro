---
import Layout from '../../layouts/Layout.astro';
import TrustStrip from '../../components/TrustStrip.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CTABand from '../../components/CTABand.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';

const faqs = [
  {
    "question": "Why did my NEMA 14-50 outlet melt?",
    "answer": "Budget outlets use thin stamped brass terminals designed for intermittent loads. Under continuous 32A EV charging, heat cycles loosen terminal screws, creating air gaps with high electrical resistance that melt the plastic housing."
  },
  {
    "question": "What makes an industrial outlet different?",
    "answer": "Industrial outlets from Bryant or Hubbell feature solid brass terminal blocks, heavy-gauge screw clamps, and glass-reinforced nylon bodies rated for sustained 75C temperatures and high-torque connections."
  },
  {
    "question": "Should I switch to a hardwired charger instead?",
    "answer": "Hardwired installations eliminate the outlet failure point entirely and support higher amperage (48A vs 32-40A). We can convert your existing circuit from plug-in to hardwired if you choose to upgrade."
  },
  {
    "question": "Does this require a permit?",
    "answer": "If a new circuit is being installed, yes. If replacing an existing outlet on an existing circuit, a permit may not be required, but we verify compliance with current NEC and local codes regardless."
  },
  {
    "question": "How often should NEMA 14-50 outlets be inspected for EV use?",
    "answer": "We recommend annual thermal inspections for any outlet used for regular EV charging. Check for loose fit, discoloration, or warmth after charging sessions."
  }
];
